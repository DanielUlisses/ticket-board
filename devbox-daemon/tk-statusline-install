#!/usr/bin/env python3
"""Wire tk-statusline into ~/.claude/settings.json (`install.sh daemon` runs this).

An existing `statusLine` command is saved to ~/.config/tk-daemon/statusline-prev,
which tk-statusline chains, and replaced by tk-statusline; its other keys (padding,
refreshInterval) are kept. Running it again changes nothing. Settings that are not a
JSON object are left alone (exit 1).

    tk-statusline-install [--bin PATH]   # PATH: default, tk-statusline beside this script
"""

import contextlib
import json
import os
import shlex
import sys
import tempfile
from pathlib import Path

HOME = Path(os.environ.get("HOME") or Path.home())
SETTINGS = HOME / ".claude/settings.json"
PREV = HOME / ".config/tk-daemon/statusline-prev"


def write_atomic(path: Path, text: str) -> None:
    """Replace `path` (through a symlink, keeping it) with `text`, keeping its mode."""
    path = path.resolve()
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o7777 if path.exists() else 0o644
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".tk-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def words_of(command: str) -> list[str]:
    try:
        return shlex.split(command)
    except ValueError:
        return command.split()


def is_ours(command: str) -> bool:
    """Whether a statusLine command runs tk-statusline (bare, quoted or via an interpreter)."""
    return any(os.path.basename(w) == "tk-statusline" for w in words_of(command))


def main(argv: list[str]) -> int:
    bin_path = str(Path(__file__).resolve().with_name("tk-statusline"))
    if "--bin" in argv:
        i = argv.index("--bin") + 1
        if i >= len(argv) or not argv[i].strip():
            print("tk-statusline-install: --bin needs a path", file=sys.stderr)
            return 2
        bin_path = argv[i]
    wanted = shlex.quote(bin_path)
    try:
        settings = json.loads(SETTINGS.read_text()) if SETTINGS.exists() else {}
        if not isinstance(settings, dict):
            raise TypeError("not a JSON object")
    except (OSError, ValueError, TypeError) as e:
        print(
            f"tk-statusline-install: {SETTINGS}: {e}; left untouched", file=sys.stderr
        )
        return 1
    line = settings.get("statusLine")
    line = line if isinstance(line, dict) else {}
    command = line.get("command")
    if isinstance(command, str) and is_ours(command):
        # moved: point at the new place, keep the saved command
        if bin_path not in words_of(command):
            settings["statusLine"] = {**line, "command": wanted}
            write_atomic(SETTINGS, json.dumps(settings, indent=2) + "\n")
        return 0
    if isinstance(command, str) and command.strip():
        write_atomic(PREV, command.strip() + "\n")
    elif PREV.exists():  # no statusLine now: a leftover saved command is not wanted
        PREV.unlink()
    settings["statusLine"] = {"type": "command", **line, "command": wanted}
    write_atomic(SETTINGS, json.dumps(settings, indent=2) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
